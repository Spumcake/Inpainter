{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "@inpainter/policy-runtime": ["../../packages/policy-runtime/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "../scripts/**/*.ts"]
}
